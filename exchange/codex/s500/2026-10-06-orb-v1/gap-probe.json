  "documentation_findings": [
    {
      "source": "faq",
      "title": "Market Data FAQ \u2014 How are bars aggregated?",
      "evidence_level": "official_primary_documentation",
      "publication_date": null,
      "summary": "Minute bars use the left edge of the SIP trade minute. Trade conditions determine price and volume updates. Bars are emitted only when all OHLCV fields are nonzero. No trades and odd-lot-only trades can both yield no bar. Five-minute bars aggregate returned minute bars; aggregation does not reconsider original trades.",
      "short_quote": "if there's only a single I trade (which only updates the volume, but none of the prices), then no bar is generated."
    },
    {
      "source": "stock-bars",
      "title": "Historical bars API reference",
      "evidence_level": "official_primary_documentation",
      "publication_date": null,
      "summary": "Explicit sip means all US exchanges; raw disables price/volume corporate-action adjustments, not ticker mapping. The asof default is current day and may map prior symbols; asof=- disables mapping. Start/end are inclusive. Pagination token must be checked even on a short page."
    },
    {
      "source": "faq",
      "summary": "The FAQ also identifies OTC subscription, inactive status and halts as reasons a queried symbol may lack data. No such individual reason was verified for these six cases."
    }
  ],
