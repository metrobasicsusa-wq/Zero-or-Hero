#!/usr/bin/env bash
# Owner, 10-21 (「老错误到底发生了多少次」): six pushes since 10-02 went out with failing tests (test.yml), five of
# them Claude's. A push that changes code, config or workflows runs the unit tests first and stops if they fail.
# Journal-only pushes skip it. Enabled per clone by: git config core.hooksPath .githooks (.claude/settings.json does it).
set -u
zero=0000000000000000000000000000000000000000
need=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then need=1; continue; fi
  if git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null | grep -qE '^(hero/|tests/|config/|\.github/workflows/|requirements\.txt)'; then
    need=1
  fi
done
[ "$need" = 0 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! out=$(timeout 600 python3 -m unittest tests.test_hero 2>&1); then
  echo "$out" | grep -E '^(FAIL|ERROR):|^Ran |^FAILED' | head -20
  echo "pre-push: tests failed, push stopped (fix them, or push with --no-verify only for an emergency)" >&2
  exit 1
fi
echo "pre-push: $(echo "$out" | grep -E '^Ran ' | tail -1) OK"
